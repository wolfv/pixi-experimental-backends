{#- Macros for cross-platform command generation -#}
{%- macro run_install() -%}
{%- if package_manager == "yarn" -%}
yarn install{% if extra_install_args %} {{ extra_install_args | join(" ") }}{% endif %}
{%- elif package_manager == "pnpm" -%}
pnpm install{% if extra_install_args %} {{ extra_install_args | join(" ") }}{% endif %}
{%- elif package_manager == "bun" -%}
bun install{% if extra_install_args %} {{ extra_install_args | join(" ") }}{% endif %}
{%- else -%}
npm install{% if extra_install_args %} {{ extra_install_args | join(" ") }}{% endif %}
{%- endif -%}
{%- endmacro -%}

{%- macro run_build(script_name) -%}
{%- if package_manager == "yarn" -%}
yarn {{ script_name }}{% if extra_build_args %} {{ extra_build_args | join(" ") }}{% endif %}
{%- elif package_manager == "pnpm" -%}
pnpm run {{ script_name }}{% if extra_build_args %} {{ extra_build_args | join(" ") }}{% endif %}
{%- elif package_manager == "bun" -%}
bun run {{ script_name }}{% if extra_build_args %} {{ extra_build_args | join(" ") }}{% endif %}
{%- else -%}
npm run {{ script_name }}{% if extra_build_args %} {{ extra_build_args | join(" ") }}{% endif %}
{%- endif -%}
{%- endmacro -%}

{%- if is_bash %}
cd "{{ source_dir }}"

# Step 1: Install dependencies
{{ run_install() }}

# Step 2: Build
{%- if build_script %}
{{ run_build(build_script) }}
{%- else %}
if node -e "const p=require('./package.json');process.exit(p.scripts&&p.scripts.build?0:1)" 2>/dev/null; then
  {{ run_build("build") }}
fi
{%- endif %}

# Step 3: Install files to $PREFIX/share/$PKG_NAME
INSTALL_DEST="$PREFIX/share/$PKG_NAME"
mkdir -p "$INSTALL_DEST"

{%- if build_output_dir %}
# Copy build output directory to install destination
cp -r "{{ source_dir }}/{{ build_output_dir }}/." "$INSTALL_DEST/"
{%- else %}
# Copy project files to install destination (excluding node_modules)
(cd "{{ source_dir }}" && tar cf - --exclude=./node_modules .) | tar xf - -C "$INSTALL_DEST"
{%- endif %}

{%- for asset in extra_assets %}
# Copy extra asset: {{ asset.src }} -> {{ asset.dst }}
mkdir -p "$INSTALL_DEST/{{ asset.dst }}"
cp -r "{{ source_dir }}/{{ asset.src }}/." "$INSTALL_DEST/{{ asset.dst }}/"
{%- endfor %}

# Step 4: Create launchers in $PREFIX/bin
mkdir -p "$PREFIX/bin"

{%- if not build_output_dir %}
# Auto-create self-relocating launchers for any "bin" entries in package.json
if [ -f "{{ source_dir }}/package.json" ]; then
node << 'NODEJS_BIN_INSTALLER_EOF'
const pkg = require('{{ source_dir }}/package.json');
const path = require('path');
const fs = require('fs');

const pkgName = process.env.PKG_NAME;
const binDir = process.env.PREFIX + '/bin';

if (pkg.bin) {
    const entries = typeof pkg.bin === 'string'
        ? { [pkg.name]: pkg.bin }
        : pkg.bin;
    for (const [name, script] of Object.entries(entries)) {
        const rel = script.replace(/^\.\//, '');
        const launcherPath = path.join(binDir, name);
        const content = [
            '#!/usr/bin/env sh',
            '_prefix="$(cd "$(dirname "$0")/.." && pwd)"',
            `exec node "\${_prefix}/share/${pkgName}/${rel}" "$@"`,
        ].join('\n') + '\n';
        fs.writeFileSync(launcherPath, content, { mode: 0o755 });
        console.log('pixi-build-nodejs: created bin launcher:', name, '->', rel);
    }
}
NODEJS_BIN_INSTALLER_EOF
fi
{%- endif %}

{%- if server_entry %}
# Create a self-relocating server launcher at $PREFIX/bin/$PKG_NAME
cat > "$PREFIX/bin/$PKG_NAME" << SERVER_LAUNCHER_EOF
#!/usr/bin/env sh
_prefix="\$(cd "\$(dirname "\$0")/.." && pwd)"
exec node "\${_prefix}/share/$PKG_NAME/{{ server_entry }}" "\$@"
SERVER_LAUNCHER_EOF
chmod +x "$PREFIX/bin/$PKG_NAME"
{%- endif %}

{%- else %}
cd /d "{{ source_dir }}"

rem Step 1: Install dependencies
{{ run_install() }}
@if errorlevel 1 exit 1

rem Step 2: Build
{%- if build_script %}
{{ run_build(build_script) }}
@if errorlevel 1 exit 1
{%- else %}
node -e "const p=require('./package.json');process.exit(p.scripts&&p.scripts.build?0:1)" 2>nul
@if not errorlevel 1 (
  {{ run_build("build") }}
  @if errorlevel 1 exit 1
)
{%- endif %}

rem Step 3: Install files to %PREFIX%\share\%PKG_NAME%
set "INSTALL_DEST=%PREFIX%\share\%PKG_NAME%"
if not exist "%INSTALL_DEST%" mkdir "%INSTALL_DEST%"

{%- if build_output_dir %}
xcopy /E /I /Y "{{ source_dir }}\{{ build_output_dir | replace("/", "\\") }}" "%INSTALL_DEST%\"
@if errorlevel 1 exit 1
{%- else %}
rem Copy project files excluding node_modules
for /d %%d in ("{{ source_dir }}\*") do (
    if /i not "%%~nxd"=="node_modules" (
        xcopy /E /I /Y "%%d" "%INSTALL_DEST%\%%~nxd\"
    )
)
for %%f in ("{{ source_dir }}\*") do (
    if not "%%~xf"=="" xcopy /I /Y "%%f" "%INSTALL_DEST%\"
)
{%- endif %}

{%- for asset in extra_assets %}
if not exist "%INSTALL_DEST%\{{ asset.dst | replace("/", "\\") }}" mkdir "%INSTALL_DEST%\{{ asset.dst | replace("/", "\\") }}"
xcopy /E /I /Y "{{ source_dir }}\{{ asset.src | replace("/", "\\") }}" "%INSTALL_DEST%\{{ asset.dst | replace("/", "\\") }}\"
@if errorlevel 1 exit 1
{%- endfor %}

rem Step 4: Create launchers in %PREFIX%\bin
if not exist "%PREFIX%\bin" mkdir "%PREFIX%\bin"

{%- if not build_output_dir %}
rem Auto-create .cmd launchers for any "bin" entries in package.json
node -e "try{const p=require('{{ source_dir | replace("\\", "/") }}/package.json'),fs=require('fs'),pa=require('path'),n=process.env.PKG_NAME,bd=process.env.PREFIX+'\\bin';if(p.bin){const e=typeof p.bin==='string'?{[p.name]:p.bin}:p.bin;for(const[k,v]of Object.entries(e)){const r=v.replace(/^\.\//,'');const lp=pa.join(bd,k+'.cmd');const c='@echo off\r\nnode \"%~dp0..\\share\\'+n+'\\'+r+'\" %*\r\n';fs.writeFileSync(lp,c);console.log('pixi-build-nodejs: created',lp);}}}catch(e){console.error(e)}"
{%- endif %}

{%- if server_entry %}
rem Create server launcher at %PREFIX%\bin\%PKG_NAME%.cmd
(
echo @echo off
echo node "%%~dp0..\share\%PKG_NAME%\{{ server_entry | replace("/", "\\") }}" %%*
) > "%PREFIX%\bin\%PKG_NAME%.cmd"
{%- endif %}
{%- endif %}
